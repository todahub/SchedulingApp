# Local development:
# - You can omit REPOSITORY_MODE to use the in-memory demo repository.
# - If you use Ollama locally, you can omit OLLAMA_BASE_URL to use http://127.0.0.1:11434/api.

# Web / Vercel deployment:
# - Set REPOSITORY_MODE=supabase
# - Choose one LLM provider with LLM_PROVIDER.
# - Gemini is the recommended default for web debugging and structured output stability.

REPOSITORY_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Optional Ollama fallback:
OLLAMA_BASE_URL=https://your-ollama-host.example.com/api
OLLAMA_MODEL=gpt-oss:20b
