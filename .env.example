# Local development:
# - You can omit REPOSITORY_MODE to use the in-memory demo repository.
# - You can omit OLLAMA_BASE_URL to use your local Ollama at http://127.0.0.1:11434/api.

# Web / Vercel deployment:
# - Set REPOSITORY_MODE=supabase
# - Point OLLAMA_BASE_URL to the publicly reachable URL for your PC-hosted Ollama server.

REPOSITORY_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OLLAMA_BASE_URL=https://your-ollama-host.example.com/api
OLLAMA_MODEL=gpt-oss:20b
